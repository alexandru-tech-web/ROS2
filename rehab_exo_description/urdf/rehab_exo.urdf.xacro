<?xml version="1.0"?>
<!-- Sistem de reabilitare v2: scaun medical + pacient integrat +
     picioare mecanice 6 GDL. Conform Fig 2.2 din documentul-sursa:
     001=baza sezut, 002=sezut, 003=baza picior mecanic, 007=picior mecanic.
     Postura zero = SEZUT. Generat parametric; verificat prin FK. -->
<robot name="rehab_exo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- COTELE NU SE SCRIU AICI. Vin din cote_derivate.xacro, generat la build din
       scripts/geometrie_core.py, unde fiecare are o clasa de provenienta (FISA,
       ANTROPO, LAYOUT) si un selftest care verifica lantul geometric. Pana pe
       22 aug 2026 erau literali in acest fisier, inventati si nemarcati, si de
       acolo venea bugul in care piciorul trecea prin placa. Regula de acum: niciun
       numar de geometrie literal in corpul descrierii. -->
  <xacro:include filename="cote_derivate.xacro"/>

  <!-- Versiunea CONVENTIEI articulare. Circula in URDF si e verificata de
       exercise_controller: o traiectorie scrisa in alta conventie e refuzata
       zgomotos, nu rulata gresit. Vezi DECIZII.md, D1. -->
  <xacro:property name="conventie_versiune" value="B1"/>

  <!-- Calea catre controllers.yaml. E parametru, nu $(find ...), fiindca xacro
       rezolva $(find) la GENERARE, iar la build pachetul nu e inca in ament_index ;
       ou si gaina. CMake paseaza calea de instalare; generarea manuala foloseste
       implicitul, care merge dupa ce pachetul a fost instalat macar o data. -->
  <xacro:arg name="postura" default="culcat"/>
  <xacro:property name="postura" value="$(arg postura)"/>

  <!-- ============ CONVENTIA ARTICULARA B-PRIM (D1, 22 aug 2026) ============
       Zeroul e ZEROUL MECANIC AL DISPOZITIVULUI, nu unul anatomic.

         sold     0 = coapsa ORIZONTALA (postura de lucru, sezut).
                  POZITIV = RIDICAREA coapsei.
         genunchi 0 = gamba in prelungirea coapsei. POZITIV = FLEXIE.
         glezna   0 = talpa perpendiculara pe gamba. POZITIV = DORSIFLEXIE.

       DE CE NU ZERO ANATOMIC (varianta B, de la M1). Argumentul podelei: cu axa
       soldului la inaltimea derivata si cu piciorul de coapsa plus gamba, o rotatie
       de 90 de grade IN JOS ar duce glezna sub podea, si asta ramane adevarat pe tot
       intervalul de reglaj al lungimilor. Un scaun nu poate fi mai inalt decat
       piciorul care atarna din el. Deci cursa merge in SUS si zeroul e orizontala.
       Argumentul nu mai e o amintire: e test permanent, in test/test_podea.py.

       Intentia lui B (comparabilitate cu literatura clinica) nu se pierde. Maparea
       anatomica e documentata in DECIZII.md ca FUNCTIE DE SPATAR, fiindca pe un
       dispozitiv cu spatar mobil unghiul anatomic de sold nu e definit fara starea
       scaunului.

       MAPAREA veche spre noua NU e presupusa aici. Se DERIVA prin cinematica directa
       in test/test_conventie.py, care genereaza si descrierea veche
       (attic/rehab_exo.xacro.conventieB) si dovedeste ca talpa ajunge in acelasi loc
       fizic. Rezultatul acelei derivari: la sold se scad 90 de grade; genunchiul si
       glezna raman neschimbate.

       CURSELE TOTALE sunt cele documentate [PDF Tabel 3.1, p.10-11]: sold 90 grade,
       genunchi 140 grade, glezna 70 grade. PLASAREA ferestrei in jurul zeroului NU e
       in document (GAP 4) si a fost mereu IPOTEZA. Transportul mecanic al plasarii
       vechi prin maparea de mai sus da pentru sold fereastra de la minus 90 la zero,
       adica integral sub orizontala, deci imposibila geometric. Asta confirma
       independent ca plasarea veche era gresita; latimea documentata se pastreaza,
       plasarea se re-deriva.
       ============================================================ -->
  <xacro:property name="rom_sold_deg"      value="90"/>
  <xacro:property name="rom_genunchi_deg"  value="140"/>
  <xacro:property name="rom_glezna_deg"    value="70"/>

  <!-- FEREASTRA COMPLETA A SOLDULUI, in conventia B-prim. Latimea de 90 de grade e
       DOCUMENTATA [PDF Tabel 3.1]; PLASAREA ei in jurul zeroului a fost mereu
       IPOTEZA (GAP 4) si a fost RE-DERIVATA la D1: repausul e coapsa orizontala si
       cursa merge in sus, fiindca in jos piciorul ar trece prin podea. -->
  <xacro:property name="sold_min_deg"      value="0"/>
  <xacro:property name="sold_max_deg"      value="90"/>

  <!-- BANDA DE SEZUT: TRANSPORTATA mecanic din conventia veche prin aceeasi mapare
       ca restul (se scad 90 de grade din 25..90), NU validata. Rezultatul cade
       integral SUB orizontala, deci e geometric imposibil, si tocmai asta e dovada
       ca plasarea veche era gresita. Se pastreaza in forma transportata ca sa nu
       ramana nimic in doua conventii, si se REJUDECA separat (punctul 5), impreuna
       cu fraza din document: "in sitting position, the motion space of the hip joint
       is small". Pana atunci: postura sezut produce deliberat un model care PICA
       invariantul podelei, iar test/test_podea.py aserteaza exact acest lucru.
       Implicitul ramane culcat. -->
  <xacro:property name="sold_sezut_min_deg" value="-65"/>
  <xacro:property name="sold_sezut_max_deg" value="0"/>

  <xacro:property name="genunchi_min_deg"  value="0"/>
  <xacro:property name="genunchi_max_deg"  value="140"/>
  <xacro:property name="glezna_min_deg"    value="-35"/>
  <xacro:property name="glezna_max_deg"    value="35"/>

  <xacro:property name="sold_lo_deg"
                  value="${sold_sezut_min_deg if postura == 'sezut' else sold_min_deg}"/>
  <xacro:property name="sold_hi_deg"
                  value="${sold_sezut_max_deg if postura == 'sezut' else sold_max_deg}"/>

  <xacro:property name="d2r" value="${pi / 180.0}"/>
  <xacro:property name="sold_lo" value="${sold_lo_deg * d2r}"/>
  <xacro:property name="sold_hi" value="${sold_hi_deg * d2r}"/>
  <xacro:property name="gen_lo"  value="${genunchi_min_deg * d2r}"/>
  <xacro:property name="gen_hi"  value="${genunchi_max_deg * d2r}"/>
  <xacro:property name="gle_lo"  value="${glezna_min_deg * d2r}"/>
  <xacro:property name="gle_hi"  value="${glezna_max_deg * d2r}"/>

  <!-- EFORT si VITEZA: DERIVATE din documentatie, nu alese. Formula si sursele in
       urdf/SPEC_DERIVATE.md, generat din scripts/spec_derivate.py.
         viteza = (rpm / 60) * 2*pi / raport_total
         efort  = min(cuplu_motor * raport * eta, cuplu_nominal_reductor)
       Cifrele vechi (120 Nm peste tot, 2.0 rad/s peste tot) nu aveau nicio sursa.
       ACESTEA sunt CAPABILITATEA masinii; pragul terapeutic e in
       config/safety_limits.yaml si e deliberat mult mai mic. -->
  <xacro:property name="ef_sold"     value="176.7"/>
  <xacro:property name="ef_genunchi" value="141.4"/>
  <xacro:property name="ef_glezna"   value="52.0"/>
  <xacro:property name="vi_sold"     value="1.5786"/>
  <xacro:property name="vi_genunchi" value="1.9732"/>
  <xacro:property name="vi_glezna"   value="3.0369"/>

  <!-- AMORTIZARE SI FRECARE PE ARTICULATIE. Statut: NEVERIFICAT, acelasi ca masele.
       Sunt necesare STABILITATII SIMULARII si INTERZISE concluziilor dinamice.
       Documentul-sursa nu da coeficienti de amortizare (GAP 1, ca si masele).

       De ce valori diferite si de ce glezna primeste mult mai mult: masurat pe
       21 aug 2026, glezna intra in oscilatie la frecventa buclei de control, cu
       schimbare de semn la FIECARE esantion si viteza fixata pe limita in 547 din
       557 de esantioane, in timp ce soldul si genunchiul merg lin cu aceeasi
       amortizare de 2.0. Cauza nu e clema de comanda: viteza COMANDATA reconstruita
       (k * eroare) atinge maxim 0.42 rad/s dintr-o limita de 3.0369, deci nu se
       apropie de ea. Cauza e raportul autoritate/inertie: 52 Nm de efort pe o
       inertie de talpa de 0.00585 kg m2 dau ~8900 rad/s2, adica limita de viteza se
       depaseste intr-un singur pas de simulare de 1 ms. Amortizarea de 2.0 e
       neglijabila fata de asta.

       Valorile de mai jos sunt ALESE prin masurare, nu derivate; vezi tabelul
       inainte/dupa din raportul zilei 3.
       Sunt ARGUMENTE, nu proprietati simple, si asta e deliberat: o proprietate NU
       se poate suprascrie din linia de comanda, iar 'xacro ... amort_glezna:=99'
       ar fi acceptat fara eroare si ignorat in tacere; a treia oara in aceeasi zi
       cand o valoare pusa in locul gresit tace in loc sa cada. Ca argumente, se pot
       balea si din launch. -->
  <xacro:arg name="amort_sold"     default="2.0"/>
  <xacro:arg name="amort_genunchi" default="2.0"/>
  <xacro:arg name="amort_glezna"   default="2.0"/>
  <xacro:arg name="frec_sold"      default="1.0"/>
  <xacro:arg name="frec_genunchi"  default="1.0"/>
  <xacro:arg name="frec_glezna"    default="1.0"/>
  <xacro:property name="amort_sold"     value="$(arg amort_sold)"/>
  <xacro:property name="amort_genunchi" value="$(arg amort_genunchi)"/>
  <xacro:property name="amort_glezna"   value="$(arg amort_glezna)"/>
  <xacro:property name="frec_sold"      value="$(arg frec_sold)"/>
  <xacro:property name="frec_genunchi"  value="$(arg frec_genunchi)"/>
  <xacro:property name="frec_glezna"    value="$(arg frec_glezna)"/>

  <xacro:arg name="controllers"
             default="$(find rehab_exo_description)/config/controllers.yaml"/>
  <!-- gazebo: cele 6 plugin-uri ApplyJointForce, canalul prin care patient_model.py
       aplica cupluri. IMPLICIT FALSE de pe 21 aug 2026, si motivul e o masuratoare,
       nu o preferinta: ApplyJointForce scrie JointForceCmd la FIECARE pas de
       simulare, chiar si cand nu a primit niciun mesaj, iar asta suprascrie
       JointVelocityCmd-ul prin care gz_ros2_control aplica comanda de pozitie.
       Cele doua se exclud reciproc. Masurat, acelasi pas de +0.30 rad pe genunchi:
         fara plugin-uri: eroare de urmarire 0.0022 rad (0.13 grade)
         cu  plugin-uri: eroare de urmarire 0.2693 rad, articulatiile doar cedeaza
                         gravitational cu viteza constanta
       Cand modelul de pacient chiar va fi condus, are nevoie de comanda in EFORT,
       nu in pozitie; atunci gazebo:=true redevine corect. Pana atunci plugin-urile
       nu aduc nimic si strica tot. -->
  <xacro:arg name="gazebo"  default="false"/>
  <xacro:arg name="senzori" default="true"/>
  <xacro:property name="gazebo"  value="$(arg gazebo)"/>
  <xacro:property name="senzori" value="$(arg senzori)"/>


  <!--
    ATENTIE: MASE SI INERTII NEVERIFICATE.
    Toate valorile de masa si inertie din acest fisier sunt PLACEHOLDER pentru
    simulare. Documentul-sursa (SPEC_LLR_twin_din_PDF.md, GAP 1) NU contine mase pe
    segmente, centre de masa sau inertii; contine doar mase de componente izolate.
    Gazebo are nevoie de ele ca sa ruleze, deci exista si raman numeric neschimbate,
    dar sunt INTERZISE pentru orice concluzie dinamica, de cuplu sau de impedanta.
    Lista completa, cu statut: urdf/MASE_NEVERIFICATE.md
    Reactivarea dinamicii (F4) cere CAD sau inertii masurate, nu aceste cifre.
  -->

  <material name="frame_gri"><color rgba="0.35 0.36 0.38 1.0"/></material>
  <material name="cushion"><color rgba="0.13 0.17 0.32 1.0"/></material>
  <material name="mech_left"><color rgba="0.20 0.45 0.80 1.0"/></material>
  <material name="mech_right"><color rgba="0.85 0.40 0.18 1.0"/></material>
  <material name="skin"><color rgba="0.88 0.72 0.58 1.0"/></material>
  <material name="cloth"><color rgba="0.18 0.42 0.40 1.0"/></material>
  <material name="pants"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="shoe"><color rgba="0.10 0.10 0.10 1.0"/></material>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0000 0.0000 0.0600" rpy="0 0 0"/>
      <mass value="22.000"/>
      <inertia ixx="0.678333" ixy="0" ixz="0" iyy="0.916667" iyz="0" izz="1.558333"/>
    </inertial>
    <!-- Placa de baza. LAYOUT: lungimea si centrul ies din intinderea ansamblului
         in postura de lucru, cu talpile incluse; latimea, din distanta dintre
         module. Cea veche era 0.7 x 0.6 centrata in origine si talpile cadeau in
         afara ei. -->
    <visual>
      <origin xyz="${g_placa_centru_x} 0 ${g_placa_grosime/2}" rpy="0 0 0"/>
      <geometry><box size="${g_placa_lungime} ${g_placa_latime} ${g_placa_grosime}"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <collision>
      <origin xyz="${g_placa_centru_x} 0 ${g_placa_grosime/2}" rpy="0 0 0"/>
      <geometry><box size="${g_placa_lungime} ${g_placa_latime} ${g_placa_grosime}"/></geometry>
    </collision>

    <!-- Coloana de ridicare a scaunului (reper 101). LAYOUT. -->
    <visual>
      <origin xyz="${g_scaun_centru_x} 0 ${(g_placa_grosime + g_scaun_sus)/2}" rpy="0 0 0"/>
      <geometry><box size="0.1600 0.1600 ${g_scaun_sus - g_placa_grosime}"/></geometry>
      <material name="frame_gri"/>
    </visual>

    <!-- CADRUL VERTICAL AL SOLDULUI, cate unul per modul de picior. Lipsea complet
         din model: coapsa pleca direct din scaun. In dispozitivul real e structura
         inalta din Fig 2.4, reper 1, care duce axa soldului la inaltimea ei. -->
    <xacro:macro name="coloana_sold" params="sy">
      <visual>
        <origin xyz="${g_sold_x} ${sy * g_sold_y} ${(g_placa_grosime + g_sold_inaltime)/2}"
                rpy="0 0 0"/>
        <geometry><box size="0.1400 0.1000 ${g_sold_inaltime - g_placa_grosime}"/></geometry>
        <material name="frame_gri"/>
      </visual>
      <collision>
        <origin xyz="${g_sold_x} ${sy * g_sold_y} ${(g_placa_grosime + g_sold_inaltime)/2}"
                rpy="0 0 0"/>
        <geometry><box size="0.1400 0.1000 ${g_sold_inaltime - g_placa_grosime}"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:coloana_sold sy="1"/>
    <xacro:coloana_sold sy="-1"/>
  </link>

  <!-- v3: ridicarea/coborarea scaunului fata de baza (ajustare pacient) -->
  <joint name="seat_lift_joint" type="prismatic">
    <parent link="base_link"/><child link="seat_link"/>
    <origin xyz="${g_scaun_centru_x} 0 ${g_scaun_centru_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Cursa e NEGATIVA fata de zero, si asta e deliberat: cota derivata a
         scaunului e pozitia de LUCRU, cea in care lantul geometric se inchide.
         Coloana 101 il COBOARA pentru transferul pacientului, nu il urca. -->
    <limit lower="-0.15" upper="0.0" effort="500.0" velocity="0.05"/><!-- NEVERIFICAT: coloana de ridicare, fara date in document -->
    <dynamics damping="50.0" friction="5.0"/>
  </joint>
  <link name="seat_link">
    <inertial>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
      <mass value="9.000"/>
      <inertia ixx="0.162375" ixy="0" ixz="0" iyy="0.162375" iyz="0" izz="0.317400"/>
    </inertial>
    <visual>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_scaun_lungime} 0.4600 ${g_scaun_grosime}"/></geometry>
      <material name="cushion"/>
    </visual>
    <visual>
      <origin xyz="0.0200 0.2950 0.2150" rpy="0 0 0"/>
      <geometry><box size="0.3400 0.0600 0.0400"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="0.0200 -0.2950 0.2150" rpy="0 0 0"/>
      <geometry><box size="0.3400 0.0600 0.0400"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="-0.1000 0.2950 0.1050" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0500 0.1800"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="-0.1000 -0.2950 0.1050" rpy="0 0 0"/>
      <geometry><box size="0.0500 0.0500 0.1800"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="0.1600 0.3050 -0.1300" rpy="0 0 0"/>
      <geometry><box size="0.1600 0.0800 0.2400"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="0.1600 -0.3050 -0.1300" rpy="0 0 0"/>
      <geometry><box size="0.1600 0.0800 0.2400"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <collision>
      <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_scaun_lungime} 0.4600 ${g_scaun_grosime}"/></geometry>
    </collision>
  </link>

  <joint name="seat_to_back" type="fixed">
    <parent link="seat_link"/><child link="backrest_link"/>
    <origin xyz="${-g_scaun_lungime/2} 0 0.02" rpy="0 -0.21 0"/>
  </joint>
  <link name="backrest_link">
    <inertial>
      <origin xyz="0.0000 0.0000 0.3000" rpy="0 0 0"/>
      <mass value="6.000"/>
      <inertia ixx="0.274000" ixy="0" ixz="0" iyy="0.170650" iyz="0" izz="0.108250"/>
    </inertial>
    <visual>
      <origin xyz="0.0000 0.0000 0.3000" rpy="0 0 0"/>
      <geometry><box size="0.0700 0.4600 0.5800"/></geometry>
      <material name="cushion"/>
    </visual>
    <visual>
      <origin xyz="0.0000 0.0000 0.6600" rpy="0 0 0"/>
      <geometry><box size="0.0600 0.2600 0.1400"/></geometry>
      <material name="cushion"/>
    </visual>
    <visual>
      <origin xyz="-0.0500 0.0000 0.6200" rpy="0 0 0"/>
      <geometry><box size="0.0400 0.5000 0.0400"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <collision>
      <origin xyz="0.0000 0.0000 0.3000" rpy="0 0 0"/>
      <geometry><box size="0.0700 0.4600 0.5800"/></geometry>
    </collision>
  </link>

  <joint name="seat_to_human" type="fixed">
    <parent link="seat_link"/><child link="human_torso"/>
    <!-- ALINIEREA PACIENT-MASINA. Bazinul pacientului se pune EXACT pe axa soldului
         masinii, cu acelasi offset ca articulatia de sold. E cerinta de baza a
         oricarui exoschelet, si pana pe 22 aug era incalcata cu 0.27 m pe x si
         0.06 m pe z: in RViz se vedea ca picioarele pacientului porneau din alt loc
         decat trunchiul lui. -->
    <origin xyz="${g_sold_x - g_scaun_centru_x} 0 ${g_sold_inaltime - g_scaun_centru_z}" rpy="0 0 0"/>
  </joint>
  <link name="human_torso">
    <inertial>
      <origin xyz="-0.1000 0.0000 0.2800" rpy="0 0 0"/>
      <mass value="32.000"/>
      <inertia ixx="1.029333" ixy="0" ixz="0" iyy="0.874667" iyz="0" izz="0.461867"/>
    </inertial>
    <visual>
      <origin xyz="-0.1000 0.0000 0.2800" rpy="0 0 0"/>
      <geometry><box size="0.2400 0.3400 0.5200"/></geometry>
      <material name="cloth"/>
    </visual>
    <visual>
      <origin xyz="-0.0900 0.0000 0.6650" rpy="0 0 0"/>
      <geometry><sphere radius="0.1050"/></geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="-0.0900 0.0000 0.5550" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0450" length="0.0700"/></geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="-0.1000 0.2050 0.4000" rpy="0.15 0 0"/>
      <geometry><cylinder radius="0.0450" length="0.2600"/></geometry>
      <material name="cloth"/>
    </visual>
    <visual>
      <origin xyz="-0.1000 -0.2050 0.4000" rpy="-0.15 0 0"/>
      <geometry><cylinder radius="0.0450" length="0.2600"/></geometry>
      <material name="cloth"/>
    </visual>
    <visual>
      <origin xyz="0.1300 0.2350 0.2350" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0400" length="0.2400"/></geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.1300 -0.2350 0.2350" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0400" length="0.2400"/></geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.2600 0.2350 0.2350" rpy="0 0 0"/>
      <geometry><sphere radius="0.0450"/></geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.2600 -0.2350 0.2350" rpy="0 0 0"/>
      <geometry><sphere radius="0.0450"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="-0.1000 0.0000 0.2800" rpy="0 0 0"/>
      <geometry><box size="0.2400 0.3400 0.5200"/></geometry>
    </collision>
  </link>

  <!-- ============ Piciorul left (mecanic 007 + membru uman) ============ -->
  <!-- Un picior mecanic. Stanga si dreapta difera EXCLUSIV prin semnul lui Y pe
       origini; axele NU se oglindesc (ambele 0 -1 0). Verificat mecanic pe URDF-ul
       livrat: dupa normalizare, cele 15 elemente sunt identice. -->
  <xacro:macro name="picior" params="side sy material">
  <joint name="${side}_hip_joint" type="revolute">
    <parent link="seat_link"/><child link="${side}_thigh"/>
    <!-- CONVENTIA B-PRIM: fara rotatie de origine, deci la unghi zero coapsa
         e ORIZONTALA, pe +X. Axa 0 -1 0 face ca unghiul POZITIV sa RIDICE coapsa.
         Vechea forma avea rpy 0 pi/2 0, care punea coapsa in jos la zero, si de
         acolo venea piciorul care trecea prin placa. -->
    <origin xyz="${g_sold_x - g_scaun_centru_x} ${sy * g_sold_y} ${g_sold_inaltime - g_scaun_centru_z}" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${sold_lo}" upper="${sold_hi}" effort="${ef_sold}" velocity="${vi_sold}"/>
    <dynamics damping="${amort_sold}" friction="${frec_sold}"/>
  </joint>
  <link name="${side}_thigh">
    <inertial>
      <origin xyz="${g_coapsa_nom/2} ${sy * -0.0575} 0.0000" rpy="0 0 0"/>
      <mass value="6.500"/>
      <inertia ixx="0.019283" ixy="0" ixz="0" iyy="0.092083" iyz="0" izz="0.100533"/>
    </inertial>
    <visual>
      <!-- ANCORA DE SCARA: reductorul de sold SHG-40-100-2UH, diametru exterior
           documentat in fisa anexata. Proportiile modelului se pot verifica cu
           ochiul fata de el. -->
      <origin xyz="0.0000 ${sy * 0.0550} 0.0000" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${g_d_sold/2}" length="0.1000"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="${g_coapsa_nom/2} 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_coapsa_nom} 0.0500 0.0700"/></geometry>
      <material name="${material}"/>
    </visual>
    <visual>
      <origin xyz="${g_coapsa_nom/2} ${sy * -0.1150} 0.0000" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0720" length="${g_coapsa_nom - 0.05}"/></geometry>
      <material name="pants"/>
    </visual>
    <collision>
      <origin xyz="${g_coapsa_nom/2} 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_coapsa_nom} 0.0600 0.0800"/></geometry>
    </collision>
  </link>
  <joint name="${side}_thigh_ext_joint" type="prismatic">
    <parent link="${side}_thigh"/><child link="${side}_thigh_ext"/>
    <origin xyz="${g_coapsa_nom} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="${g_coapsa_cursa}" effort="300.0" velocity="0.03"/><!-- NEVERIFICAT: push rod fara date de forta sau viteza in document -->
    <dynamics damping="30.0" friction="3.0"/>
  </joint>
  <link name="${side}_thigh_ext">
    <inertial>
      <origin xyz="-0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <mass value="0.800"/>
      <inertia ixx="0.000273" ixy="0" ixz="0" iyy="0.001873" iyz="0" izz="0.001813"/>
    </inertial>
    <visual>
      <origin xyz="-0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1600 0.0380 0.0550"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <!-- ANCORA DE SCARA: reductorul de genunchi SHG-32-100-2UH, diametru
           exterior din fisa anexata. -->
      <origin xyz="0.0000 ${sy * 0.0400} 0.0000" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${g_d_genunchi/2}" length="0.0800"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <collision>
      <origin xyz="-0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1600 0.0400 0.0600"/></geometry>
    </collision>
  </link>
  <joint name="${side}_knee_joint" type="revolute">
    <parent link="${side}_thigh_ext"/><child link="${side}_shank"/>
    <!-- Fara rotatie: la genunchi zero gamba continua coapsa, tot pe +X.
         Axa 0 1 0 duce flexia POZITIVA in jos, adica gamba coboara. -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${gen_lo}" upper="${gen_hi}" effort="${ef_genunchi}" velocity="${vi_genunchi}"/>
    <dynamics damping="${amort_genunchi}" friction="${frec_genunchi}"/>
  </joint>
  <link name="${side}_shank">
    <inertial>
      <origin xyz="${g_gamba_nom/2} ${sy * -0.0575} 0.0000" rpy="0 0 0"/>
      <mass value="4.000"/>
      <inertia ixx="0.059867" ixy="0" ixz="0" iyy="0.054967" iyz="0" izz="0.008167"/>
    </inertial>
    <visual>
      <origin xyz="${g_gamba_nom/2} 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_gamba_nom} 0.0450 0.0500"/></geometry>
      <material name="${material}"/>
    </visual>
    <visual>
      <origin xyz="${g_gamba_nom/2} ${sy * -0.1150} 0.0000" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0580" length="${g_gamba_nom - 0.05}"/></geometry>
      <material name="pants"/>
    </visual>
    <collision>
      <origin xyz="${g_gamba_nom/2} 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="${g_gamba_nom} 0.0500 0.0600"/></geometry>
    </collision>
  </link>
  <joint name="${side}_shank_ext_joint" type="prismatic">
    <parent link="${side}_shank"/><child link="${side}_shank_ext"/>
    <origin xyz="${g_gamba_nom} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="${g_gamba_cursa}" effort="300.0" velocity="0.03"/><!-- NEVERIFICAT: push rod fara date de forta sau viteza in document -->
    <dynamics damping="30.0" friction="3.0"/>
  </joint>
  <link name="${side}_shank_ext">
    <inertial>
      <origin xyz="0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <mass value="0.600"/>
      <inertia ixx="0.001060" ixy="0" ixz="0" iyy="0.001060" iyz="0" izz="0.000160"/>
    </inertial>
    <visual>
      <origin xyz="0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.0340 0.0380"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <collision>
      <origin xyz="0.0500 0.0000 0.0000" rpy="0 0 0"/>
      <geometry><box size="0.1400 0.0400 0.0400"/></geometry>
    </collision>
  </link>
  <joint name="${side}_ankle_joint" type="revolute">
    <parent link="${side}_shank_ext"/><child link="${side}_foot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${gle_lo}" upper="${gle_hi}" effort="${ef_glezna}" velocity="${vi_glezna}"/>
    <dynamics damping="${amort_glezna}" friction="${frec_glezna}"/>
  </joint>
  <link name="${side}_foot">
    <inertial>
      <origin xyz="${g_glezna_offset} ${sy * -0.0575} ${g_talpa_lungime/4}" rpy="0 0 0"/>
      <mass value="1.200"/>
      <inertia ixx="0.002050" ixy="0" ixz="0" iyy="0.005850" iyz="0" izz="0.007720"/>
    </inertial>
    <visual>
      <!-- Placa de talpa: perpendiculara pe gamba, la offsetul de glezna sub axa,
           intinsa inainte. Glezna cade la circa un sfert din lungime de la calcai. -->
      <origin xyz="${g_glezna_offset} 0.0000 ${g_talpa_lungime/4}" rpy="0 0 0"/>
      <geometry><box size="0.0250 0.1300 ${g_talpa_lungime}"/></geometry>
      <material name="frame_gri"/>
    </visual>
    <visual>
      <origin xyz="${g_glezna_offset - 0.035} ${sy * -0.1150} ${g_talpa_lungime/4}" rpy="0 0 0"/>
      <geometry><box size="0.0550 0.0850 ${g_talpa_lungime - 0.02}"/></geometry>
      <material name="shoe"/>
    </visual>
    <collision>
      <origin xyz="${g_glezna_offset} 0.0000 ${g_talpa_lungime/4}" rpy="0 0 0"/>
      <geometry><box size="0.0300 0.1400 ${g_talpa_lungime}"/></geometry>
    </collision>
  </link>
  </xacro:macro>

  <!-- Intrarile de ros2_control ale unui picior. In URDF-ul livrat NU erau
       contigue (left, right si seat_lift intercalate); aici sunt un macro. -->
  <xacro:macro name="picior_control" params="side">
    <joint name="${side}_hip_joint">
      <command_interface name="position">
        <param name="min">-0.45</param>
        <param name="max">0.7</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${side}_knee_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.75</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${side}_ankle_joint">
      <command_interface name="position">
        <param name="min">-0.6</param>
        <param name="max">0.6</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${side}_thigh_ext_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.08</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${side}_shank_ext_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.08</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:picior side="left"  sy="1"  material="mech_left"/>
  <xacro:picior side="right" sy="-1" material="mech_right"/>


  <!-- ============ Piciorul right (mecanic 007 + membru uman) ============ -->

  <ros2_control name="RehabExoSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    <!-- Versiunea conventiei articulare, purtata de model pana la consumatori.
         exercise_controller o compara cu versiunea traiectoriei si REFUZA rularea la
         nepotrivire: o traiectorie scrisa in alta conventie ar misca robotul in alta
         parte decat scrie pe ea. Aici, si nu intr-un comentariu, fiindca un
         comentariu nu ajunge in /robot_description. -->
    <param name="conventie_versiune">${conventie_versiune}</param>
      <!-- position_proportional_gain NU se pune aici. In gz_ros2_control 1.2.17 e
           un PARAMETRU ROS al nodului controller_manager, nu un param de hardware
           din URDF; pus aici e citit de nimeni si tace. Dovedit prin masurare: la
           15.0 si la 300.0 raspunsul la treapta e identic pana la a treia zecimala.
           Locul lui real e config/controllers.yaml, sub controller_manager. -->
    </hardware>
    <!-- left_hip: encoder absolut (position) + torque (effort); comanda pozitie+viteza -->
    <xacro:picior_control side="left"/>
    <xacro:picior_control side="right"/>
    <!-- left_knee: encoder absolut (position) + torque (effort); comanda pozitie+viteza -->
    <!-- left_ankle: senzor de unghi (position) + torque (effort); comanda pozitie+viteza -->
    <!-- right_hip: encoder absolut (position) + torque (effort); comanda pozitie+viteza -->
    <!-- right_knee: encoder absolut (position) + torque (effort); comanda pozitie+viteza -->
    <!-- right_ankle: senzor de unghi (position) + torque (effort); comanda pozitie+viteza -->
    <!-- Axele de ajustare (prismatice): comanda pozitie, stare completa -->
    <joint name="seat_lift_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.15</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>


  <xacro:if value="${gazebo}">
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_hip_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_knee_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_ankle_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_hip_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_knee_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_ankle_joint</joint_name>
    </plugin>
  </gazebo>
  </xacro:if>

  <xacro:if value="${senzori}">
  <gazebo reference="base_link">
    <sensor name="imu_base_link" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>rehab/imu/base_link</topic>
    </sensor>
  </gazebo>
  <gazebo reference="left_foot">
    <sensor name="imu_left_foot" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>rehab/imu/left_foot</topic>
    </sensor>
  </gazebo>
  <gazebo reference="right_foot">
    <sensor name="imu_right_foot" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>rehab/imu/right_foot</topic>
    </sensor>
  </gazebo>
  </xacro:if>

</robot>
